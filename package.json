{
  "name": "opencode-v2-cli-codex-usage",
  "version": "1.0.0",
  "description": "OpenCode V2 CLI plugin that displays OpenAI Codex usage in the sidebar",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.0.16"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/node": "^22.13.5",
    "babel-preset-solid": "^1.9.5",
    "esbuild": "^0.25.0",
    "solid-js": "^1.9.5",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "codex",
    "openai",
    "usage",
    "rate-limits",
    "sidebar",
    "tui",
    "cli"
  ]
}
